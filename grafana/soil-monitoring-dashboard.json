{
  "title": "Soil Monitoring Dashboard",
  "description": "Real-time soil moisture, temperature, and humidity tracking per plot",
  "panels": [
    {
      "title": "Moisture Gauge",
      "type": "gauge",
      "datasource": "InfluxDB",
      "targets": [
        {
          "query": "SELECT last(\"moisture\") FROM \"soil_readings\" WHERE (\"plot_id\" =~ /^$plot_id$/) GROUP BY \"plot_id\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "green", "value": 40 },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "title": "Moisture 24h Trend",
      "type": "timeseries",
      "targets": [
        {
          "query": "SELECT \"moisture\" FROM \"soil_readings\" WHERE (\"plot_id\" =~ /^$plot_id$/) AND $timeFilter"
        }
      ]
    },
    {
      "title": "Temperature & Humidity",
      "type": "timeseries",
      "targets": [
        {
          "query": "SELECT \"temp\", \"humidity\" FROM \"soil_readings\" WHERE (\"plot_id\" =~ /^$plot_id$/) AND $timeFilter"
        }
      ]
    },
    {
      "title": "Alert History",
      "type": "table",
      "targets": [
        {
          "query": "SELECT \"alert_level\", \"moisture\" FROM \"soil_readings\" WHERE (\"plot_id\" =~ /^$plot_id$/) ORDER BY time DESC LIMIT 50"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "plot_id",
        "type": "query",
        "datasource": "InfluxDB",
        "query": "SHOW TAG VALUES FROM \"soil_readings\" WITH KEY = \"plot_id\""
      }
    ]
  }
}
