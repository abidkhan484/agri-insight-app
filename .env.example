# ==============================================================================
# ZBNF Farming Assistant — Unified Environment Configuration
# ==============================================================================
# This file contains all configuration variables for the Bot, AI Service, and PWAs.
# Copy this to .env and fill in your values.

# ------------------------------------------------------------------------------
# 1. Core Telegram Bot (src/)
# ------------------------------------------------------------------------------
BOT_TOKEN=your_telegram_bot_token_from_botfather
NODE_ENV=production
TIMEZONE=Asia/Dhaka
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Database (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# Required for the Bot and Map PWA.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-for-backend
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-signing-pwa-tokens
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-for-frontend
DB_NAME=postgres

# ------------------------------------------------------------------------------
# 3. AI Assistant (ai-assistant/) - [Optional for Cloud]
# ------------------------------------------------------------------------------
AI_API_URL=http://localhost:5000
OLLAMA_MODEL=gemma2:2b
EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
CHROMA_DB_PATH=./chroma_db
FLASK_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# 4. PWAs (disease-detect, krishi-record, etc.)
# ------------------------------------------------------------------------------
# PlantNet API Key (Get at my.plantnet.org)
VITE_PLANTNET_API_KEY=your_plantnet_api_key

# Subdirectory path for hosting (e.g., /agri-insight-app/)
VITE_BASE_URL=/agri-insight-app/
