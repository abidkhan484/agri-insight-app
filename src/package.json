{
  "name": "zbnf-farming-assistant",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bot/index.js",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "dotenv": "^16.x",
    "node-cron": "^3.x",
    "telegraf": "^4.x",
    "winston": "^3.x"
  },
  "devDependencies": {
    "@eslint/js": "^9.x",
    "eslint": "^9.x",
    "eslint-config-prettier": "^9.x",
    "husky": "^9.x",
    "lint-staged": "^15.x",
    "prettier": "^3.x",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
